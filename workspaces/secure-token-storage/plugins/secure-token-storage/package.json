{
  "name": "@red-hat-developer-hub/backstage-plugin-secure-token-storage",
  "version": "0.1.0",
  "description": "Frontend plugin for managing secure provider token connections and grants",
  "license": "Apache-2.0",
  "main": "src/index.tsx",
  "types": "src/index.tsx",
  "exports": {
    ".": "./src/index.tsx",
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "package.json": [
        "package.json"
      ]
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/redhat-developer/rhdh-plugins",
    "directory": "workspaces/secure-token-storage/plugins/secure-token-storage"
  },
  "backstage": {
    "role": "frontend-plugin",
    "pluginId": "secure-token-storage",
    "pluginPackage": "@red-hat-developer-hub/backstage-plugin-secure-token-storage",
    "pluginPackages": [
      "@red-hat-developer-hub/backstage-plugin-secure-token-storage",
      "@red-hat-developer-hub/backstage-plugin-secure-token-storage-node",
      "@red-hat-developer-hub/backstage-plugin-secure-token-storage-backend"
    ]
  },
  "sideEffects": false,
  "scripts": {
    "start": "backstage-cli package start",
    "build": "backstage-cli package build",
    "lint": "backstage-cli package lint",
    "test": "backstage-cli package test",
    "clean": "backstage-cli package clean",
    "prepack": "backstage-cli package prepack",
    "postpack": "backstage-cli package postpack"
  },
  "dependencies": {
    "@backstage/core-plugin-api": "^1.12.9",
    "@backstage/frontend-plugin-api": "^0.18.0",
    "@mui/icons-material": "5.18.0",
    "@mui/material": "5.18.0"
  },
  "peerDependencies": {
    "react": "^17.0.0 || ^18.0.0",
    "react-dom": "^17.0.0 || ^18.0.0",
    "react-router-dom": "^6.30.2"
  },
  "devDependencies": {
    "@backstage/cli": "^0.36.5",
    "@backstage/frontend-defaults": "^0.5.5",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "react": "^18.0.2",
    "react-dom": "^18.0.2",
    "react-router-dom": "^6.30.2"
  },
  "files": [
    "dist",
    "dist-scalprum"
  ],
  "scalprum": {
    "name": "red-hat-developer-hub.backstage-plugin-secure-token-storage",
    "exposedModules": {
      "PluginRoot": "./src/index.tsx"
    }
  }
}
